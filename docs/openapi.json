  "info": {
    "title": "Supreme Maintenance API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready",
              "not_ready"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "unavailable"
            ]
          },
          "authentication": {
            "type": "string",
            "enum": [
              "configured",
              "unconfigured"
            ],
            "description": "Configuration only; not a provider connectivity check."
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "requestId"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "OPERATOR",
          "TECHNICIAN",
          "MAINTENANCE_HEAD",
          "SUPERVISOR",
          "MANAGEMENT",
          "ADMINISTRATOR"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "organization": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "userId",
          "membershipId",
          "displayName",
          "orgId",
          "organization",
          "role"
        ]
      },
      "NamedDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "MachineDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "WH-C"
          },
          "name": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "nullable": true
          },
          "operationalStatus": {
            "type": "string",
            "example": "NOT_MONITORED",
            "description": "Registry status, not live telemetry."
          },
          "department": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/NamedDto"
              }
            ]
          },
          "location": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/NamedDto"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "manufacturer",
          "model",
          "operationalStatus",
          "department",
          "location",
          "createdAt",
          "updatedAt"
        ]
      },
      "MachinesDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MachineDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "SheetInfoDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "month": {
            "type": "string",
            "nullable": true
          },
          "supported": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "heading": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "month",
          "supported",
          "reason",
          "heading"
        ]
      },
      "WorkbookInfoDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "workbookHash": {
            "type": "string"
          },
          "sheets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SheetInfoDto"
            }
          }
        },
        "required": [
          "filename",
          "workbookHash",
          "sheets"
        ]
      },
      "ProductionRowDto": {
        "type": "object",
        "properties": {
          "sourceRow": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "JOB",
              "ACTIVITY"
            ]
          },
          "shift": {
            "type": "string",
            "nullable": true,
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "description": {
            "type": "string"
          },
          "productionKg": {
            "type": "number",
            "nullable": true
          },
          "jobChanges": {
            "type": "number",
            "nullable": true
          },
          "scrap": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "downtime": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "remarks": {
            "type": "string"
