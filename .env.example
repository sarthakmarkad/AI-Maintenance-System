# API/scripts: copy to .env in repository root. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Runtime login: narrow application grants, NOT migration owner.
DATABASE_URL=postgresql://maintenance_runtime:CHANGE_ME@127.0.0.1:55432/maintenance?schema=maintenance
# Migration / seed / provisioning login; direct connection or Supabase session pooler.
DIRECT_URL=postgresql://maintenance_owner:CHANGE_ME@127.0.0.1:55432/maintenance?schema=maintenance
# Empty auth configuration starts API in fail-closed, unconfigured mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Test runner requires a separate database with a name ending in _test.
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=

# Optional legacy direct OpenAI provider (DOCUMENT_AI_PROVIDER=openai). Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
DOCUMENT_AI_ENABLED=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5.4-mini-2026-03-17

# Preferred document assistant: CommandCode GOAT + local Ollama embeddings.
DOCUMENT_AI_PROVIDER=commandcode
COMMANDCODE_API_KEY=
COMMANDCODE_MODEL=deepseek/deepseek-v4.1-flash
# Optional one-time hosted database transfer. Keep credentials backend-only.
# Leave DATABASE_URL/DIRECT_URL unchanged until the verified cutover.
# SUPABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# SUPABASE_CA_CERT=/absolute/private/path/to/project-ca.crt
# Hosted runtime/owner URLs need schema=maintenance and verified TLS settings.
# See docs/SUPABASE-MIGRATION.md for the current session-pooler/CA setup and CLI limits.
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# AI RCA is advisory drafting for the assigned breakdown technician.
# Uses the selected backend answer provider; false disables generation.
RCA_AI_ENABLED=true
# Optional external email delivery. Keep off until sender/provider are configured.
EXTERNAL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=resend
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
# Optional reviewed digest override; changing it creates a separate embedding profile.
# LOCAL_EMBEDDING_DIGEST=<64 lowercase hex characters>

# Staff invitations: private persistent 32-byte hex signing key, never NEXT_PUBLIC_.
TEAM_INVITATION_SECRET=

# Set true only after configuring and testing Supabase custom SMTP for staff.
TEAM_PASSWORD_EMAIL_READY=false
