# Host runtime secret store or private .local/deploy/backend.env, never commit real values.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=https://YOUR_PROJECT.vercel.app
# Restricted runtime login; URL-encode credentials; mount project CA at referenced path.
DATABASE_URL=postgresql://RUNTIME_LOGIN:ENCODED_PASSWORD@SESSION_POOLER:5432/postgres?schema=maintenance&sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=PUBLIC_PUBLISHABLE_KEY
TEAM_INVITATION_SECRET=EXISTING_64_HEX_SIGNING_KEY
TEAM_PASSWORD_EMAIL_READY=true
DOCUMENT_AI_PROVIDER=commandcode
COMMANDCODE_API_KEY=PRIVATE_COMMANDCODE_KEY
COMMANDCODE_MODEL=deepseek/deepseek-v4.1-flash
DOCUMENT_RETRIEVAL_MODE=keyword
# Enable only after migration 035 and provider configuration are verified.
DOCUMENT_AI_ENABLED=true
RCA_AI_ENABLED=true
# Keep delivery disabled during initial hosted rehearsal; review before enabling.
EXTERNAL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=resend
RESEND_API_KEY=PRIVATE_RESEND_KEY
NOTIFICATION_EMAIL_FROM=notifications@maintenate.sarthakmarkad.xyz
