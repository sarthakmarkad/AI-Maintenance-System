generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["maintenance"]
}
enum Role {
  OPERATOR
  TECHNICIAN
  MAINTENANCE_HEAD
  SUPERVISOR
  MANAGEMENT
  ADMINISTRATOR
  @@schema("maintenance")
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(80)
  name String @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  departments Department[]
  locations Location[]
  memberships Membership[]
  machines Machine[]
  auditEvents AuditEvent[]
  @@schema("maintenance")
}
model Department {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  name String @db.VarChar(120)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  machines Machine[]
  @@unique([orgId, id])
  @@unique([orgId, name])
  @@schema("maintenance")
}
model Location {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  name String @db.VarChar(160)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  machines Machine[]
  @@unique([orgId, id])
  @@unique([orgId, name])
  @@schema("maintenance")
}
model AppUser {
  // Matches a verified Supabase Auth user ID. Not a user-editable profile role.
  id String @id @db.Uuid
  displayName String @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  membership Membership?
  auditEvents AuditEvent[]
  productionImports ProductionImport[]
  readingImports ReadingImport[]
  @@schema("maintenance")
}
model Membership {
  staffInvitationsCreated TeamInvitation[] @relation("StaffInvitationCreator")
  staffInvitationsAccepted TeamInvitation[] @relation("StaffInvitationAcceptor")
  staffActions TeamAction[]
  staffEmailRequests TeamInvitationEmail[]
  teamVersion Int @default(1)
  staffEmail String? @db.VarChar(254)
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  orgId String @db.Uuid
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  machineAccess MachineAccess[]
  roleGrants MembershipRoleGrant[]
  reportedOrders WorkOrder[] @relation("OrderReporter")
  assignedOrders WorkOrder[] @relation("OrderTechnician")
  reviewedOrders WorkOrder[] @relation("OrderReviewer")
  closedOrders WorkOrder[] @relation("OrderCloser")
  orderEvents WorkOrderEvent[]
  documentEvents MachineDocumentEvent[]
  documentChats DocumentChat[]
  orderAttachments WorkOrderAttachment[]
  createdPlans MaintenancePlan[] @relation("PlanCreator")
  technicianPlans MaintenancePlan[] @relation("PlanTechnician")
  scheduledOccurrences MaintenanceOccurrence[] @relation("OccurrenceTechnician")
  skippedOccurrences MaintenanceOccurrence[] @relation("OccurrenceSkipper")
  notificationReceipts WorkOrderNotificationReceipt[]
  reminderReceipts MaintenanceReminderReceipt[]
  anomalyReviews AnomalyReview[]
  @@unique([orgId,userId])
  @@unique([orgId, id])
  @@index([orgId, role, active])
  @@schema("maintenance")
  ExternalNotificationPreference ExternalNotificationPreference[]
  RcaDraftRequest                RcaDraftRequest[]
}
model MembershipRoleGrant {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  membershipId String @db.Uuid
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  membership Membership @relation(fields:[orgId,membershipId],references:[orgId,id],onDelete:Restrict)
  @@unique([membershipId,role])
  @@index([orgId,membershipId,active])
  @@schema("maintenance")
}
model Machine {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  code String @db.VarChar(32)
  name String @db.VarChar(160)
  manufacturer String? @db.VarChar(160)
  version Int @default(1)
  registrationKey String? @db.Uuid
  registrationHash String? @db.VarChar(64)
  model String? @db.VarChar(160)
  // Unknown means unknown: registry metadata is not a live health measurement.
  operationalStatus String @default("NOT_MONITORED") @db.VarChar(32)
  archivedAt DateTime? @db.Timestamptz(3)
  archiveReason String? @db.VarChar(4000)
  departmentId String? @db.Uuid
  locationId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [orgId, departmentId], references: [orgId, id], onDelete: Restrict)
  location Location? @relation(fields: [orgId, locationId], references: [orgId, id], onDelete: Restrict)
  photo MachinePhoto?
  access MachineAccess[]
  productionImports ProductionImport[]
  productionDays ProductionDay[]
  readingImports ReadingImport[]
  processReadings ProcessReading[]
  documents MachineDocument[]
  documentChats DocumentChat[]
  workOrders WorkOrder[]
  maintenancePlans MaintenancePlan[]
  maintenanceOccurrences MaintenanceOccurrence[]
  anomalyReviews AnomalyReview[]
  @@unique([orgId, id])
  @@unique([orgId, code])
  @@unique([orgId, registrationKey])
  @@index([orgId, departmentId])
  @@index([orgId, locationId])
  @@schema("maintenance")
  ExternalNotificationPreference ExternalNotificationPreference[]
}
model MachineAccess {
  orgId String @db.Uuid
  machineId String @db.Uuid
  membershipId String @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields: [orgId, machineId], references: [orgId, id], onDelete: Cascade)
  membership Membership @relation(fields: [orgId, membershipId], references: [orgId, id], onDelete: Cascade)
  @@id([machineId, membershipId])
  @@index([orgId, membershipId])
  @@schema("maintenance")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  // Nullable for system seed events; actor user ID otherwise. Immutable history.
  actorId String? @db.Uuid
  action String @db.VarChar(80)
  entityId String @db.VarChar(120)
  detail Json
  at DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([orgId, at])
  @@schema("maintenance")
}

enum ProductionSource {
  AUTHENTIC
  SYNTHETIC
  @@schema("maintenance")
}
enum ProductionImportStatus {
  PREVIEW
  COMMITTED
  @@schema("maintenance")
}
enum ProductionShift {
  A
  B
  C
  @@schema("maintenance")
}
enum ProductionRowKind {
  JOB
  ACTIVITY
  @@schema("maintenance")
}
model ProductionImport {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  source ProductionSource
  filename String @db.VarChar(180)
  workbookHash String @db.VarChar(64)
  sheet String @db.VarChar(100)
  parserVersion String @db.VarChar(40)
  status ProductionImportStatus @default(PREVIEW)
  staged Json
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  committedDayKeys String[] @default([])
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  creator AppUser @relation(fields:[createdBy],references:[id],onDelete:Restrict)
  days ProductionDay[]
  @@unique([orgId,machineId,source,id])
  @@index([orgId,machineId,createdAt])
  @@index([createdBy])
  @@schema("maintenance")
}
model ProductionDay {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  importId String @db.Uuid
  source ProductionSource
  date DateTime @db.Date
  productionKg Decimal @db.Decimal(16,3)
  scrapKg Decimal @db.Decimal(16,3)
  controlProductionKg Decimal @db.Decimal(16,3)
  controlScrapKg Decimal @db.Decimal(16,3)
  sourceStartRow Int
  sourceEndRow Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  import ProductionImport @relation(fields:[orgId,machineId,source,importId],references:[orgId,machineId,source,id],onDelete:Restrict)
  rows ProductionRow[]
  @@unique([orgId,machineId,source,date])
  @@unique([orgId,machineId,id])
  @@index([importId])
  @@schema("maintenance")
}
model ProductionRow {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  dayId String @db.Uuid
  sourceRow Int
  kind ProductionRowKind
  shift ProductionShift
  description String @db.Text
  productionKg Decimal? @db.Decimal(16,3)
  jobChanges Int?
  scrap Json
  downtime Json
  downtimeUnit String @default("UNCONFIRMED") @db.VarChar(20)
  remarks String @db.Text
  rawCells Json
  day ProductionDay @relation(fields:[orgId,machineId,dayId],references:[orgId,machineId,id],onDelete:Restrict)
  @@unique([dayId,sourceRow])
  @@index([orgId,machineId])
  @@schema("maintenance")
}

enum ReadingImportStatus {
  PREVIEW
  COMMITTED
  @@schema("maintenance")
}
model ReadingImport {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  source ProductionSource @default(SYNTHETIC)
  filename String @db.VarChar(180)
  workbookHash String @db.VarChar(64)
  sheet String @default("Hourly_Readings") @db.VarChar(100)
  parserVersion String @db.VarChar(50)
  policyVersion String @db.VarChar(50)
  staged Json
  status ReadingImportStatus @default(PREVIEW)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  creator AppUser @relation(fields:[createdBy],references:[id],onDelete:Restrict)
  readings ProcessReading[]
  @@unique([orgId,machineId,source,id])
  @@index([orgId,machineId,createdAt])
  @@index([createdBy])
  @@schema("maintenance")
}
model ProcessReading {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  importId String @db.Uuid
  source ProductionSource @default(SYNTHETIC)
  sourceId String @db.VarChar(64)
  sourceRow Int
  measuredAt DateTime @db.Timestamptz(3)
  receivedAt DateTime @db.Timestamptz(3)
  localMeasuredAt String @db.VarChar(19)
  demoShift ProductionShift
  hotTempC Decimal @db.Decimal(12,3)
  coldTempC Decimal @db.Decimal(12,3)
  pressureBar Decimal @db.Decimal(12,3)
  rawCells Json
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  import ReadingImport @relation(fields:[orgId,machineId,source,importId],references:[orgId,machineId,source,id],onDelete:Restrict)
  @@unique([orgId,machineId,source,measuredAt])
  @@unique([orgId,machineId,source,sourceId])
  @@unique([importId,sourceRow])
  @@index([importId])
  @@schema("maintenance")
}

enum WorkOrderStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  AWAITING_REVIEW
  APPROVED
  CLOSED
  CANCELLED
  @@schema("maintenance")
}
enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  @@schema("maintenance")
}
enum ReportedImpact {
  STOPPED
  DEGRADED
  OBSERVATION
  @@schema("maintenance")
}
model WorkOrder {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  requestId String @db.Uuid
  reportFingerprint String @db.VarChar(64)
  title String @db.VarChar(160)
  kind WorkOrderKind @default(BREAKDOWN)
  occurrenceId String? @unique @db.Uuid
  anomalyReviewId String? @unique @db.Uuid
  performedAt DateTime? @db.Timestamptz(3)
  investigationOutcome InvestigationOutcome?
  description String @db.Text
  priority WorkOrderPriority @default(NORMAL)
  impact ReportedImpact
  observedAt DateTime? @db.Timestamptz(3)
  reportedAt DateTime @default(now()) @db.Timestamptz(3)
  reportedBy String @db.Uuid
  status WorkOrderStatus @default(REPORTED)
  version Int @default(1)
  technicianId String? @db.Uuid
  startedAt DateTime? @db.Timestamptz(3)
  findings String? @db.Text
  rootCause String? @db.Text
  correctiveAction String? @db.Text
  preventiveAction String? @db.Text
  restoredAt DateTime? @db.Timestamptz(3)
  submittedAt DateTime? @db.Timestamptz(3)
  returnReason String? @db.Text
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewedBy String? @db.Uuid
  closedAt DateTime? @db.Timestamptz(3)
  closedBy String? @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  reporter Membership @relation("OrderReporter",fields:[orgId,reportedBy],references:[orgId,userId],onDelete:Restrict)
  technician Membership? @relation("OrderTechnician",fields:[orgId,technicianId],references:[orgId,userId],onDelete:Restrict)
  reviewer Membership? @relation("OrderReviewer",fields:[orgId,reviewedBy],references:[orgId,userId],onDelete:Restrict)
  closer Membership? @relation("OrderCloser",fields:[orgId,closedBy],references:[orgId,userId],onDelete:Restrict)
  events WorkOrderEvent[]
  attachments WorkOrderAttachment[]
  occurrence MaintenanceOccurrence? @relation(fields:[orgId,machineId,occurrenceId],references:[orgId,machineId,id],onDelete:Restrict)
  anomalyReview AnomalyReview? @relation(fields:[orgId,machineId,anomalyReviewId],references:[orgId,machineId,id],onDelete:Restrict)
  @@unique([orgId,machineId,occurrenceId])
  @@unique([orgId,machineId,anomalyReviewId])
  @@unique([orgId,machineId,id])
  @@unique([orgId,reportedBy,requestId])
  @@index([orgId,machineId,reportedAt,id])
  @@index([orgId,machineId,status,reportedAt])
  @@index([orgId,technicianId])
  @@schema("maintenance")
  RcaDraftRequest      RcaDraftRequest[]
}
enum WorkOrderKind {
  BREAKDOWN
  PLANNED
  INVESTIGATION
  @@schema("maintenance")
}

enum InvestigationOutcome {
  MAINTENANCE_REQUIRED
  SENSOR_CHECK_REQUIRED
  OPERATING_CHANGE_EXPLAINED
  NO_FAULT_FOUND
  INCONCLUSIVE
  @@schema("maintenance")
}
enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  @@schema("maintenance")
}
enum MaintenanceReminderKind {
  UPCOMING
  DUE
  OVERDUE
  @@schema("maintenance")
}
model MaintenancePlan {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  requestId String @db.Uuid
  fingerprint String @db.VarChar(64)
  title String @db.VarChar(160)
  instructions String @db.Text
  frequency MaintenanceFrequency
  interval Int @default(1)
  firstDueAt DateTime @db.Timestamptz(3)
  technicianId String @db.Uuid
  priority WorkOrderPriority @default(NORMAL)
  remindDays Int @default(3)
  active Boolean @default(true)
  version Int @default(1)
  pauseReason String? @db.Text
  nextSequence Int @default(0)
  lastGeneratedAt DateTime? @db.Timestamptz(3)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  creator Membership @relation("PlanCreator",fields:[orgId,createdBy],references:[orgId,userId],onDelete:Restrict)
  technician Membership @relation("PlanTechnician",fields:[orgId,technicianId],references:[orgId,userId],onDelete:Restrict)
  occurrences MaintenanceOccurrence[]
  @@unique([orgId,machineId,id])
  @@unique([orgId,createdBy,requestId])
  @@index([active,id])
  @@index([orgId,machineId,createdAt])
  @@schema("maintenance")
}
model MaintenanceOccurrence {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  planId String @db.Uuid
  sequence Int
  dueAt DateTime @db.Timestamptz(3)
  remindAt DateTime @db.Timestamptz(3)
  title String @db.VarChar(160)
  instructions String @db.Text
  technicianId String @db.Uuid
  priority WorkOrderPriority
  version Int @default(1)
  skippedAt DateTime? @db.Timestamptz(3)
  skippedBy String? @db.Uuid
  skipReason String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  plan MaintenancePlan @relation(fields:[orgId,machineId,planId],references:[orgId,machineId,id],onDelete:Restrict)
  technician Membership @relation("OccurrenceTechnician",fields:[orgId,technicianId],references:[orgId,userId],onDelete:Restrict)
  skipper Membership? @relation("OccurrenceSkipper",fields:[orgId,skippedBy],references:[orgId,userId],onDelete:Restrict)
  workOrder WorkOrder?
  reminders MaintenanceReminder[]
  @@unique([orgId,machineId,id])
  @@unique([planId,sequence])
  @@unique([planId,dueAt])
  @@index([orgId,machineId,dueAt,id])
  @@index([dueAt,remindAt])
  @@schema("maintenance")
}
model MaintenanceReminder {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  occurrenceId String @db.Uuid
  kind MaintenanceReminderKind
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  occurrence MaintenanceOccurrence @relation(fields:[orgId,machineId,occurrenceId],references:[orgId,machineId,id],onDelete:Restrict)
  receipts MaintenanceReminderReceipt[]
  @@unique([occurrenceId,kind])
  @@unique([orgId,machineId,id])
  @@index([orgId,machineId,createdAt])
  @@schema("maintenance")
}
model MaintenanceReminderReceipt {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  reminderId String @db.Uuid
  userId String @db.Uuid
  role Role
  readAt DateTime @default(now()) @db.Timestamptz(3)
  reminder MaintenanceReminder @relation(fields:[orgId,machineId,reminderId],references:[orgId,machineId,id],onDelete:Restrict)
  reader Membership @relation(fields:[orgId,userId],references:[orgId,userId],onDelete:Restrict)
  @@unique([reminderId,userId,role])
  @@schema("maintenance")
}
model WorkOrderEvent {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  orderId String @db.Uuid
  version Int
  action String @db.VarChar(16)
  fromStatus WorkOrderStatus?
  toStatus WorkOrderStatus
  actorId String @db.Uuid
  actorName String @db.VarChar(120)
  actorRole Role
  detail Json
  at DateTime @default(now()) @db.Timestamptz(3)
  order WorkOrder @relation(fields:[orgId,machineId,orderId],references:[orgId,machineId,id],onDelete:Restrict)
  actor Membership @relation(fields:[orgId,actorId],references:[orgId,userId],onDelete:Restrict)
  notificationReceipts WorkOrderNotificationReceipt[]
  attachment WorkOrderAttachment?
  @@unique([orgId,machineId,id])
  @@unique([orderId,version])
  @@index([orgId,machineId,orderId,version])
  @@schema("maintenance")
  ExternalNotificationOutbox ExternalNotificationOutbox[]
}

model WorkOrderAttachment {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  orderId String @db.Uuid
  orderVersion Int
  requestId String @db.Uuid
  fingerprint String @db.VarChar(64)
  filename String @db.VarChar(160)
  description String @db.VarChar(1000)
  mediaType String @db.VarChar(32)
  byteSize Int
  sha256 String @db.VarChar(64)
  content Bytes
  uploadedBy String @db.Uuid
  uploaderName String @db.VarChar(120)
  actorRole Role
  status WorkOrderStatus
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order WorkOrder @relation(fields:[orgId,machineId,orderId],references:[orgId,machineId,id],onDelete:Restrict,onUpdate:NoAction,map:"WorkOrderAttachment_order_fkey")
  uploader Membership @relation(fields:[orgId,uploadedBy],references:[orgId,userId],onDelete:Restrict,onUpdate:NoAction,map:"WorkOrderAttachment_uploader_fkey")
  event WorkOrderEvent @relation(fields:[orderId,orderVersion],references:[orderId,version],onDelete:Restrict,onUpdate:NoAction,map:"WorkOrderAttachment_event_fkey")
  @@unique([orderId,orderVersion])
  @@unique([orgId,orderId,uploadedBy,requestId])
  @@index([orgId,machineId,orderId,createdAt,id])
  @@schema("maintenance")
}

enum AnomalyDecision {
  INVESTIGATE
  DISMISSED
  @@schema("maintenance")
}
model AnomalyReview {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  key String @db.VarChar(64)
  policyVersion String @db.VarChar(64)
  measuredAt DateTime @db.Timestamptz(3)
  decision AnomalyDecision
  reason String @db.VarChar(2000)
  reviewedBy String @db.Uuid
  actorRole Role
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  reviewer Membership @relation(fields:[orgId,reviewedBy],references:[orgId,userId],onDelete:Restrict)
  workOrder WorkOrder?
  @@unique([orgId,machineId,key])
  @@unique([orgId,machineId,id])
  @@index([orgId,machineId,createdAt,id])
  @@schema("maintenance")
}

// Notifications derive from immutable workflow events; only explicit reads write.
model WorkOrderNotificationReceipt {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  eventId String @db.Uuid
  userId String @db.Uuid
  role Role
  readAt DateTime @default(now()) @db.Timestamptz(3)
  event WorkOrderEvent @relation(fields:[orgId,machineId,eventId],references:[orgId,machineId,id],onDelete:Restrict,onUpdate:NoAction,map:"WorkOrderNotificationReceipt_event_fkey")
  reader Membership @relation(fields:[orgId,userId],references:[orgId,userId],onDelete:Restrict,onUpdate:NoAction,map:"WorkOrderNotificationReceipt_reader_fkey")
  @@unique([eventId,userId,role])
  @@index([orgId,machineId,userId,role])
  @@schema("maintenance")
}

// Immutable logical metadata, version files and events; only aggregate version advances.
model MachineDocument {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  title String @db.VarChar(160)
  kind String @db.VarChar(16)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId], references:[orgId,id], onDelete:Restrict)
  files MachineDocumentFile[]
  events MachineDocumentEvent[]
  @@unique([orgId,machineId,id])
  @@index([orgId,machineId,createdAt,id])
  @@schema("maintenance")
}
model MachineDocumentFile {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  documentId String @db.Uuid
  number Int
  filename String @db.VarChar(160)
  description String @db.VarChar(1000)
  byteSize Int
  sha256 String @db.VarChar(64)
  content Bytes
  document MachineDocument @relation(fields:[orgId,machineId,documentId], references:[orgId,machineId,id], onDelete:Restrict)
  events MachineDocumentEvent[]
  ragIndexes DocumentRagIndex[]
  @@unique([orgId,machineId,documentId,id])
  @@unique([documentId,number])
