generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["maintenance"]
}
enum Role {
  OPERATOR
  TECHNICIAN
  MAINTENANCE_HEAD
  SUPERVISOR
  MANAGEMENT
  ADMINISTRATOR
  @@schema("maintenance")
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(80)
  name String @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  departments Department[]
  locations Location[]
  memberships Membership[]
  machines Machine[]
  auditEvents AuditEvent[]
  @@schema("maintenance")
}
model Department {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  name String @db.VarChar(120)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  machines Machine[]
  @@unique([orgId, id])
  @@unique([orgId, name])
  @@schema("maintenance")
}
model Location {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  name String @db.VarChar(160)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  machines Machine[]
  @@unique([orgId, id])
  @@unique([orgId, name])
  @@schema("maintenance")
}
model AppUser {
  // Matches a verified Supabase Auth user ID. Not a user-editable profile role.
  id String @id @db.Uuid
  displayName String @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  membership Membership?
  auditEvents AuditEvent[]
  productionImports ProductionImport[]
  readingImports ReadingImport[]
  @@schema("maintenance")
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  orgId String @db.Uuid
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  machineAccess MachineAccess[]
  @@unique([orgId, id])
  @@index([orgId, role, active])
  @@schema("maintenance")
}
model Machine {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  code String @db.VarChar(32)
  name String @db.VarChar(160)
  manufacturer String @db.VarChar(160)
  model String? @db.VarChar(160)
  // Unknown means unknown: registry metadata is not a live health measurement.
  operationalStatus String @default("NOT_MONITORED") @db.VarChar(32)
  departmentId String? @db.Uuid
  locationId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [orgId, departmentId], references: [orgId, id], onDelete: Restrict)
  location Location? @relation(fields: [orgId, locationId], references: [orgId, id], onDelete: Restrict)
  access MachineAccess[]
  productionImports ProductionImport[]
  productionDays ProductionDay[]
  readingImports ReadingImport[]
  processReadings ProcessReading[]
  @@unique([orgId, id])
  @@unique([orgId, code])
  @@index([orgId, departmentId])
  @@index([orgId, locationId])
  @@schema("maintenance")
}
model MachineAccess {
  orgId String @db.Uuid
  machineId String @db.Uuid
  membershipId String @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields: [orgId, machineId], references: [orgId, id], onDelete: Cascade)
  membership Membership @relation(fields: [orgId, membershipId], references: [orgId, id], onDelete: Cascade)
  @@id([machineId, membershipId])
  @@index([orgId, membershipId])
  @@schema("maintenance")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  // Nullable for system seed events; actor user ID otherwise. Immutable history.
  actorId String? @db.Uuid
  action String @db.VarChar(80)
  entityId String @db.VarChar(120)
  detail Json
  at DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([orgId, at])
  @@schema("maintenance")
}

enum ProductionSource {
  AUTHENTIC
  SYNTHETIC
  @@schema("maintenance")
}
enum ProductionImportStatus {
  PREVIEW
  COMMITTED
  @@schema("maintenance")
}
enum ProductionShift {
  A
  B
  C
  @@schema("maintenance")
}
enum ProductionRowKind {
  JOB
  ACTIVITY
  @@schema("maintenance")
}
model ProductionImport {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  source ProductionSource
  filename String @db.VarChar(180)
  workbookHash String @db.VarChar(64)
  sheet String @db.VarChar(100)
  parserVersion String @db.VarChar(40)
  status ProductionImportStatus @default(PREVIEW)
  staged Json
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  committedDayKeys String[] @default([])
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  creator AppUser @relation(fields:[createdBy],references:[id],onDelete:Restrict)
  days ProductionDay[]
  @@unique([orgId,machineId,source,id])
  @@index([orgId,machineId,createdAt])
  @@index([createdBy])
  @@schema("maintenance")
}
model ProductionDay {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  importId String @db.Uuid
  source ProductionSource
  date DateTime @db.Date
  productionKg Decimal @db.Decimal(16,3)
  scrapKg Decimal @db.Decimal(16,3)
  controlProductionKg Decimal @db.Decimal(16,3)
  controlScrapKg Decimal @db.Decimal(16,3)
  sourceStartRow Int
  sourceEndRow Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  import ProductionImport @relation(fields:[orgId,machineId,source,importId],references:[orgId,machineId,source,id],onDelete:Restrict)
  rows ProductionRow[]
  @@unique([orgId,machineId,source,date])
  @@unique([orgId,machineId,id])
  @@index([importId])
  @@schema("maintenance")
}
model ProductionRow {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  dayId String @db.Uuid
  sourceRow Int
  kind ProductionRowKind
  shift ProductionShift
  description String @db.Text
  productionKg Decimal? @db.Decimal(16,3)
  jobChanges Int?
  scrap Json
  downtime Json
  downtimeUnit String @default("UNCONFIRMED") @db.VarChar(20)
  remarks String @db.Text
  rawCells Json
  day ProductionDay @relation(fields:[orgId,machineId,dayId],references:[orgId,machineId,id],onDelete:Restrict)
  @@unique([dayId,sourceRow])
  @@index([orgId,machineId])
  @@schema("maintenance")
}

enum ReadingImportStatus {
  PREVIEW
  COMMITTED
  @@schema("maintenance")
}
model ReadingImport {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  source ProductionSource @default(SYNTHETIC)
  filename String @db.VarChar(180)
  workbookHash String @db.VarChar(64)
  sheet String @default("Hourly_Readings") @db.VarChar(100)
  parserVersion String @db.VarChar(50)
  policyVersion String @db.VarChar(50)
  staged Json
  status ReadingImportStatus @default(PREVIEW)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  creator AppUser @relation(fields:[createdBy],references:[id],onDelete:Restrict)
  readings ProcessReading[]
  @@unique([orgId,machineId,source,id])
  @@index([orgId,machineId,createdAt])
  @@index([createdBy])
  @@schema("maintenance")
}
model ProcessReading {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  machineId String @db.Uuid
  importId String @db.Uuid
  source ProductionSource @default(SYNTHETIC)
  sourceId String @db.VarChar(64)
  sourceRow Int
  measuredAt DateTime @db.Timestamptz(3)
  receivedAt DateTime @db.Timestamptz(3)
  localMeasuredAt String @db.VarChar(19)
  demoShift ProductionShift
  hotTempC Decimal @db.Decimal(12,3)
  coldTempC Decimal @db.Decimal(12,3)
  pressureBar Decimal @db.Decimal(12,3)
  rawCells Json
  machine Machine @relation(fields:[orgId,machineId],references:[orgId,id],onDelete:Restrict)
  import ReadingImport @relation(fields:[orgId,machineId,source,importId],references:[orgId,machineId,source,id],onDelete:Restrict)
  @@unique([orgId,machineId,source,measuredAt])
  @@unique([orgId,machineId,source,sourceId])
  @@unique([importId,sourceRow])
  @@index([importId])
  @@schema("maintenance")
}
